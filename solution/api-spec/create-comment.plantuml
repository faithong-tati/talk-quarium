@startjson create-comment
{
  "path": "/comments/:postId",
  "httpMethod": "POST",
  "header": {
    "authorization": "string"
  }
  ,
  "param": {
    "postId": "number"
  }
  ,
  "body": {
    "content": "string"
  }
  ,
  "response": {
    "successful": "boolean",
    "errorCode": "string",
    "message": "string",
    "data": {
      "id": "number",
      "content": "string",
      "createdAt": "string",
      "createdBy": "datetime(6)",
      "postId": "number",
      "updatedAt": "string",
      "updatedBy": "datetime(6)",
      "userId": "number"
    }
  }
  ,
  "errorCode": [
  {
    "code": "00",
    "message": "Success",
    "httpStatus": "200"
  }
  ,
  {
    "code": "03",
    "message": "Server Error",
    "httpStatus": "500"
  }
  ,
  {
    "code": "06",
    "message": "Invalid data",
    "httpStatus": "400"
  }
  ,
  {
    "code": "10",
    "message": "Unauthorized",
    "httpStatus": "401"
  }
  ]
}
@endjson