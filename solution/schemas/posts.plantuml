@startuml posts
entity posts {
  * id: int4(32) <<PK>>
  --
  * user_id: int4(32) <<FK>>
  --
  * topic: enum(food,pets,health,fashion,exercise,others)
  * title: varchar(255)
  * content: text
  --
  * created_at: datetime(6)
  * updated_at: datetime(6)
  deleted_at: datetime(6)
  * created_by: varchar(255)
  * updated_by: varchar(255)
  deleted_by: varchar(255)
}
@enduml
